# Production settings for the API. Copy to /etc/licht/api.env on the server, fill in, then `chmod 600` it.
# Never commit the filled-in file. Ask the project owner for the real database URL and secrets.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Long random value, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=admin@lichtsignaturesouvenirs.store
ADMIN_PASSWORD=

# --- Domain ---
# The storefront and API share https://lichtsignaturesouvenirs.store (nginx forwards /api and /uploads here).
# These already default to that in production (src/main/resources/application-prod.properties); set them only to
# use a different domain.
# FRONTEND_URL=https://lichtsignaturesouvenirs.store
# CORS_ALLOWED_ORIGINS=https://lichtsignaturesouvenirs.store,https://www.lichtsignaturesouvenirs.store
# UPLOAD_PUBLIC_BASE_URL=/uploads
# UPLOAD_DIR=/var/lib/licht/uploads

# --- Port on this server (nginx forwards to it) ---
# If another app already uses 8090, use 8091 here AND in the frontend's deploy/nginx-storefront.conf.
PORT=8090

# --- Email (password resets and order emails are only logged until this is set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=orders@lichtsignaturesouvenirs.store
ADMIN_NOTIFY_EMAIL=

# --- PayPal (hidden at checkout until both are set) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Optional ---
# STORE_CURRENCY=GBP
# TURNSTILE_SECRET_KEY=
